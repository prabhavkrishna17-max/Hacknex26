# ==========================================
# HackNEX 2026 - Workspace .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
service-account*.json

# Operating System files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor & IDE settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node.js / Frontend frameworks
node_modules/
jspm_packages/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/
.turbo/
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
poetry.lock
Pipfile.lock

# Database / SQLite / Local storage
*.sqlite
*.sqlite3
*.db
*.local.db

# Logs and runtime artifacts
logs/
*.log
*.pid
*.seed
*.pid.lock
tmp/
temp/
scratch/
