# ==============================================================================
# HackNEX 2026 - Environment Variables Template
# Copy this file to .env before running the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit real credentials, tokens, or API keys to git.
# - The .env file is strictly excluded via .gitignore.
# ==============================================================================

# Server / Runtime Environment
PORT=3000
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# AI & LLM Provider API Keys (Populate based on chosen stack/models)
# REQUIRED for the real baseline (LLM + embeddings): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Database / Storage (Optional - populate if needed by problem statement)
# DATABASE_URL=postgresql://user:password@localhost:5432/hacknex_db
# REDIS_URL=redis://localhost:6379

# Authentication / Security Secrets (Generate random high-entropy strings)
# SESSION_SECRET=change_me_to_a_random_32_character_secret
# JWT_SECRET=change_me_to_a_random_32_character_secret

# External Service Integrations (Add placeholders as stack is selected)
# WEBHOOK_SECRET=your_webhook_secret_here
